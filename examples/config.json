{
  "namespace": "authelia",
  "url": "https://sso.app.example.com",
  "ingress_enabled": true,
  "ingress_class": "traefik",
  "cookie_domain": "app.example.com",
  "cookie_name": "authelia_sso_session",
  "session_idle": "2h",
  "session_max": "12h",
  "image": "authelia/authelia:4.39.28",
  "storage_size": "1Gi",
  "ldap_address": "ldaps://idm01.sun.example.com:636",
  "ldap_starttls": false,
  "ldap_implementation": "freeipa",
  "ldap_base_dn": "dc=example,dc=com",
  "ldap_user": "uid=authelia-bind,cn=users,cn=compat,dc=example,dc=com",
  "ldap_users_filter": "(&({username_attribute}={input})(objectClass=person)(!(nsAccountLock=TRUE)))",
  "ldap_groups_filter": "(&(member={dn})(objectClass=groupOfNames))",
  "ldap_username_attribute": "uid",
  "ldap_display_attribute": "cn",
  "ldap_mail_attribute": "mail",
  "ldap_password": "CHANGE_ME",
  "smtp_address": "submission://mail01.sun.example.com:587",
  "smtp_username": "send@example.com",
  "smtp_password": "CHANGE_ME",
  "smtp_sender": "send@example.com",
  "ca_pem": "",
  "ca_mode": "manual",
  "ca_file": "ldap-ca.pem",
  "ca_fingerprint": "",
  "smtp_ca_mode": "system",
  "smtp_ca_file": "smtp-ca.pem",
  "smtp_ca_fingerprint": "",
  "protected_domain": "",
  "allowed_group": "sysadmins",
  "policy": "two_factor",
  "oidc_policies": {
    "staff": {"group": "sysadmins", "policy": "two_factor"}
  },
  "oidc_clients": [
    {"client_id": "dashboard", "client_name": "Dashboard", "redirect_uris": ["https://dashboard.app.example.com/auth/callback"], "authorization_policy": "staff", "require_pkce": true},
    {"client_id": "webui", "client_name": "Web UI", "redirect_uris": ["https://webui.app.example.com/api/auth/oidc/callback"], "authorization_policy": "staff", "require_pkce": true}
  ]
}
